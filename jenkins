pipeline {
  agent { label 'windows' }

  stages {
    stage('Install deps') {
      steps {
        bat 'npm install'
      }
    }
    stage('Build') {
      steps {
        bat 'npm run build'
      }
    }
    stage('Test') {
      steps {
        bat 'npm test -- --watch=false'
      }
    }
    stage('Checkout') {
  steps {
    git url: 'https://github.com/trojanxi/yogesh_portfolio.git',
        branch: 'main',
        credentialsId: 'trojanxi-portfolio'
  }
}
  }
}
